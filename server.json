{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.GriffMurder/taskbullet",
  "title": "TaskBullet",
  "description": "Delegate tasks and US/CA phone calls an AI agent cannot finish to a human VA.",
  "repository": {
    "url": "https://github.com/GriffMurder/taskbullet-mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://taskbullet.com",
  "icons": [
    {
      "src": "https://taskbullet.com/icons/icon-512x512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    },
    {
      "src": "https://taskbullet.com/icons/icon-64x64.png",
      "mimeType": "image/png",
    "sizes": ["64x64"]
  }
  ],
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@taskbullet/mcp-server",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TASKBULLET_API_KEY",
          "description": "TaskBullet API key (tb_live_...)",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "TASKBULLET_API_BASE",
          "description": "Override the Agent API base URL. Defaults to https://taskbullet.com/api/v1.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "TASKBULLET_SOURCE_AGENT",
          "description": "Audit label stored with each delegated task. Defaults to mcp-client.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://taskbullet.com/api/agent-mcp",
      "headers": [
        {
          "name": "x-api-key",
          "description": "TaskBullet API key (tb_live_...)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
