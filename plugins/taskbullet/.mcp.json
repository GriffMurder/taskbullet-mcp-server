{
  "mcpServers": {
    "taskbullet": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/index.js"],
      "env": {
        "CLAUDE_PLUGIN_OPTION_TASKBULLET_API_KEY": "${user_config.TASKBULLET_API_KEY}",
        "CLAUDE_PLUGIN_OPTION_TASKBULLET_HTTP_TOKEN": "${user_config.TASKBULLET_HTTP_TOKEN}"
      }
    }
  }
}
