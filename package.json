{
  "name": "@taskbullet/mcp-server",
  "version": "0.2.2",
  "mcpName": "io.github.GriffMurder/taskbullet",
  "description": "MCP server for delegating tasks and US/CA phone calls from AI agents (Claude, Cursor, OpenClaw, Grok) to real human virtual assistants. Stdio and streamable HTTP.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "cursor",
    "openclaw",
    "anthropic",
    "ai-agent",
    "ai-agent-handoff",
    "human-in-the-loop",
    "virtual-assistant",
    "va",
    "taskbullet",
    "task-delegation",
    "phone-calls",
    "agent-tools",
    "ai-tools",
    "llm-tools",
    "autonomous-agent"
  ],
  "author": "TaskBullet <hello@taskbullet.com>",
  "license": "MIT",
  "homepage": "https://taskbullet.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/GriffMurder/taskbullet-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/GriffMurder/taskbullet-mcp-server/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "taskbullet-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
